---
import BaseLayout from './BaseLayout.astro'
import { Banner } from '../components/Banner.jsx'
import { Breadcrumbs } from '../components/Breadcrumbs.jsx'
import { pageSearch } from '../lib/site.js'

const { title, description } = Astro.props
const url = Astro.url.pathname.replace(/index\.html$/, '')
---
<BaseLayout title={title} description={description} search={pageSearch(url)}>
  <div class="min-h-[250px]">
    <Banner title={title} />
  </div>
  <div class='flex flex-col items-top mb-2'>
    <div class='mx-2 sm:mx-8 lg:mx-[100px] flex flex-col min-[2600px]:mx-auto min-[2600px]:w-[50vw]'>
      <div class='col-span-2 mt-4 mb-4'>
        <Breadcrumbs breadcrumbs={{ Home: '/', [title]: '#' }} />
      </div>
      <slot />
    </div>
  </div>
</BaseLayout>
