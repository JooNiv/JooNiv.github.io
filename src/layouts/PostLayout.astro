---
import BaseLayout from './BaseLayout.astro'
import { Banner } from '../components/Banner.jsx'
import { Breadcrumbs } from '../components/Breadcrumbs.jsx'
import { BlogTags } from '../components/BlogTags.jsx'
import { ReferencesAccordion } from '../components/ReferencesAccordion.jsx'
import { ReadNext } from '../components/ReadNext.jsx'
import { constants, authors } from '../lib/constants.js'
import { getPublications } from '../lib/site.js'

const { entry } = Astro.props
const { title, description, date, filters, tags, header } = entry.data
const author = authors[entry.data.author]
const type = filters.Type
const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
const displayDate = `${months[date.getUTCMonth()]} ${date.getUTCDate()}, ${date.getUTCFullYear()}`
const publications = await getPublications()
---
<BaseLayout title={title} description={description} image={header.teaser}>
  <Fragment slot="head">
    <script is:inline>
      MathJax = {
        tex: {
          inlineMath: [['$', '$'], ['\\(', '\\)']],
          displayMath: [['$$', '$$'], ['\\[', '\\]']]
        },
        svg: { fontCache: 'global' }
      };
    </script>
    <script is:inline id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
  </Fragment>

  <Banner title={type} />
  <article class="pb-[60px] itemscope" itemtype="http://schema.org/BlogPosting">
    <div id="blogView" class='flex flex-col items-top mb-2'>
      <div class='lg:grid lg:grid-cols-6 mx-2 sm:mx-8 lg:mx-[100px] flex flex-col gap-0 min-[2600px]:mx-auto min-[2600px]:max-w-[50vw]'>
        <div class='col-span-full mt-4 pb-8'>
          <Breadcrumbs breadcrumbs={{ Home: '/', 'Blogs and instructions': '/publications/', [title]: '#' }} />
        </div>
        <div class='col-span-1 pb-8 2xl:pb-0 lg:col-span-4 2xl:col-span-1 text-on-white text-[14px]' id="author-data">
          <div class='flex flex-row gap-2 2xl:flex-row'>
            {author && author.name !== 'FiQCI Team' && (
              <img src={author.avatar} alt='Author' class='object-scale-down max-w-28' />
            )}
            <div class='flex flex-col gap-4'>
              <p class='font-bold mb-0!'>{author?.name}</p>
              <p class='max-w-[220px] text-wrap mt-0! mb-0!'>{author?.bio}</p>
            </div>
          </div>
        </div>
        <div class='col-span-4 max-w-[740px] lg:mr-[48px] 2xl:mr-0 2xl:justify-self-center' id="tags-data">
          <BlogTags client:load tags={tags} />
          <time datetime={date.toISOString()} itemprop="datePublished">{type} | {displayDate}</time>
          <h1 class='pt-[8px] mt-0! text-4xl font-bold text-gray-900 mb-4'>{title}</h1>
          <div class="prose inline" itemprop="articleBody">
            <slot />
          </div>
          <br />
          <div>
            <h2 class="text-[1.5em] font-bold">Give feedback!</h2>
            <br />
            <p class="text-gray-600">Feedback is greatly appreciated! You can send feedback directly to <a href={`mailto:${constants.feedback_email}`}> {constants.feedback_email} </a>.</p>
          </div>
          <div class="pt-8" id="references">
            <div id="references-accordion" class="not-prose">
              <ReferencesAccordion client:only="react" />
            </div>
          </div>
        </div>
        <div class='lg:block col-span-full lg:col-span-2 2xl:col-span-1 xl:w-full xl:max-w-screen max-w-[740px] lg:overflow-hidden! h-full scroll-smooth' style='height:fit-content;'>
          <div id="read-next" class="not-prose">
            <ReadNext client:load title={title} publications={publications} />
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
