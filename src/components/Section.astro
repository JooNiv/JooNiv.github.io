---
const { heading } = Astro.props
const id = heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '')
---
<section class="mx-2 sm:mx-8 lg:mx-[100px] py-[32px] min-[2600px]:mx-auto min-[2600px]:max-w-[50vw]">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-on-surface" id={id}>{heading}</h2>
  </div>
  <div class="not-prose">
    <slot />
  </div>
</section>
