---
import { constants } from '../lib/constants.js'
import { isDevSite } from '../lib/env.js'

const { title, description, image } = Astro.props
const pageUrl = new URL(Astro.url.pathname, Astro.site)
const absolute = path => new URL(path, Astro.site).href
const matomoUrl = import.meta.env.PUBLIC_MATOMO_URL
---
<head>
  <title>{title}{constants.title_separator}{constants.title}</title>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script is:inline>
    (() => {
      const root = document.documentElement
      const media = matchMedia('(prefers-color-scheme: dark)')
      const stored = () => { try { return localStorage.getItem('theme') } catch { return null } }
      const apply = () => { root.dataset.theme = stored() || (media.matches ? 'dark' : 'light') }
      apply()
      media.addEventListener('change', () => { if (!stored()) apply() })
    })()
  </script>
  <meta name="description" content={description || constants.description}>
  {isDevSite && <meta name="robots" content="noindex, nofollow">}

  <meta property="og:type" content="website">
  <meta property="og:url" content={pageUrl.href}>
  <meta property="og:title" content={title || constants.title}>
  <meta property="og:description" content={description || title}>
  <meta property="og:image" content={absolute(image || constants.preview)}>
  <meta name="google-site-verification" content="p4UjGUzyLKNumVehEA-0X6ISlYP4z9Rr9uKWDWo1PVA" />

  <link rel="icon" href={`/${constants.favicon}`} />
  <link rel="preload" as="image" href="/assets/images/FiQCI-banner.webp"
        imagesrcset="/assets/images/FiQCI-banner-640.webp 640w, /assets/images/FiQCI-banner-1024.webp 1024w, /assets/images/FiQCI-banner.webp 1280w, /assets/images/FiQCI-banner-1920.webp 1920w"
        imagesizes="100vw" fetchpriority="high">
  <link rel="preconnect" href="https://rsms.me/" crossorigin>
  <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
  {matomoUrl && <link rel="preconnect" href={`https://${matomoUrl}`}>}
  <link rel="dns-prefetch" href="https://fiqci-backend.2.rahtiapp.fi">
  <slot />
</head>
