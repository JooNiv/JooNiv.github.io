---
import BaseLayout from '../layouts/BaseLayout.astro'
import Section from '../components/Section.astro'
import { Hero } from '../components/Hero.jsx'
import { AccessCards } from '../components/AccessCards.jsx'
import { BlogCards } from '../components/BlogCards.jsx'
import { EventCards } from '../components/EventCards.jsx'
import { constants } from '../lib/constants.js'
import { getPublications, getEvents } from '../lib/site.js'

const home = constants['/']
const about = constants['/about/']
const missionLinks = home.mission.links
const publications = await getPublications()
const events = await getEvents()
const arrow = 'M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z'
const pitch = [
  'Through FiQCI, Finnish researchers have access to one of the most powerful hybrid HPC+nQC resources in the world.',
  'Available for quantum-accelerated research and development.',
]
---
<BaseLayout title="Welcome">
  <Hero client:load {...home.hero} />

  <Section heading="Get Access"><AccessCards client:load cards={home.access_cards || []} /></Section>
  <Section heading="Blogs and Instructions"><BlogCards client:load publications={publications} /></Section>
  <Section heading="Events"><EventCards client:load events={events} /></Section>

  <div id="about" class="pb-20 text-white bg-[#0D2B53] w-full">
    <div class="mx-2 sm:mx-8 lg:mx-[100px] min-[2600px]:mx-auto min-[2600px]:max-w-[50vw]">
      <div class="flex flex-col-reverse md:flex-row">
        <div class="flex-auto md:mt-8 md:pt-12 mr-0 lg:mr-32 md:mr-20">
          <div class="mb-6 hidden md:block">
            <h2 id="about-fiqci">FiQCI Mission</h2>
          </div>
          <div class="pb-4">
            <p class="mb-4">{about.mission}</p>
            <p>{about.maintain}</p>
            {[missionLinks.about, missionLinks.access].map(link => (
              <div class="mt-4">
                <a href={link.href} class="text-sky-200 hover:underline font-bold">
                  <div class="sm:mx-0 flex items-center gap-3">
                    <div class="text-sm">{link.title}</div>
                    <svg class="icon" viewBox="0 0 24 24" width="24" height="24"><path d={arrow} /></svg>
                  </div>
                </a>
              </div>
            ))}
          </div>
        </div>
        <div class="w-full pb-4 md:pb-0 md:min-w-64 mt-8 pt-12 md:mt-0 md:pt-0">
          <div class="mb-6 md:hidden">
            <h2 id="about-fiqci-mobile">FiQCI Mission</h2>
          </div>
          <section class="bg-[#0066CC] text-white text-left font-bold text-lg py-8 px-2 sm:px-8">
            <p class="mb-4">{pitch[0]}</p>
            <p class="mb-0">{pitch[1]}</p>
          </section>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  #hero-background-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #hero-container {
    position: relative;
    width: 100%;
    min-height: 400px;
    height: 400px;
  }
</style>
